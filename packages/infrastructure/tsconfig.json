{
  // إعدادات TypeScript لحزمة infrastructure
  // تعتمد على حزمتي domain و application — تنفذ المنافذ المعرّفة فيهما
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {},
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  // مراجع المشاريع — تضمن بناء domain و application أولاً
  "references": [
    { "path": "../domain" },
    { "path": "../application" }
  ]
}
