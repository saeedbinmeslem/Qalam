# نسخة مثال لمتغيرات البيئة. انسخها إلى apps/web/.env.local واملأ القيم.
# بدون مفاتيح Supabase يعمل الدخول التطويري (غير مسموح في الإنتاج).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# عنوان الموقع لروابط الدخول السحرية (اتركه فارغًا محليًا)
NEXT_PUBLIC_SITE_URL=

# لوحة التحكم الإدارية
# بريد المديرين مفصولًا بفواصل، في كل البيئات. بدونه لا يدخل أحد اللوحة ولا يظهر رابطها لأحد.
ADMIN_EMAILS=
# الذكاء الاصطناعي (توليد مسودات أسئلة الاختبارات من ملاحظاتك). بدونه تعمل المنصة وتُعطَّل ميزة التوليد فقط.
# الخيار المجاني: مفتاح Gemini من https://aistudio.google.com/apikey (لا يحتاج بطاقة). اشتراك Google AI Pro لا يشمل API.
# تنبيه: في الفئة المجانية تستعمل Google المحتوى لتحسين منتجاتها؛ نرسل عنوان الدرس وملاحظاتك فقط.
GEMINI_API_KEY=
# اختياري: النموذج (الافتراضي gemini-3.8-flash)
GEMINI_MODEL=
# بديل مدفوع: Claude
ANTHROPIC_API_KEY=
# اختياري: النموذج (الافتراضي claude-opus-5-5)
ANTHROPIC_MODEL=
# اختياري: فرض المزوّد (gemini | anthropic)؛ الافتراضي أول مفتاح متوفر
LLM_PROVIDER=
# مفتاح الخدمة لكتابة لوحة التحكم على Supabase (سرّي: على الخادم فقط، لا تضعه في NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=
