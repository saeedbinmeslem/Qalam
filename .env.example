# نسخة مثال لمتغيرات البيئة. انسخها إلى apps/web/.env.local واملأ القيم.
# بدون مفاتيح Supabase يعمل الدخول التطويري (غير مسموح في الإنتاج).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# عنوان الموقع لروابط الدخول السحرية (اتركه فارغًا محليًا)
NEXT_PUBLIC_SITE_URL=

# لوحة التحكم الإدارية
# بريد المديرين مفصولًا بفواصل، في كل البيئات. بدونه لا يدخل أحد اللوحة ولا يظهر رابطها لأحد.
ADMIN_EMAILS=
# الذكاء الاصطناعي (توليد مسودات أسئلة الاختبارات من ملاحظاتك). بدونه تعمل المنصة وتُعطَّل ميزة التوليد فقط.
# الخيار المجاني: مفتاح Gemini من https://aistudio.google.com/apikey (لا يحتاج بطاقة). اشتراك Google AI Pro لا يشمل API.
# تنبيه: في الفئة المجانية تستعمل Google المحتوى لتحسين منتجاتها؛ نرسل عنوان الدرس وملاحظاتك فقط.
GEMINI_API_KEY=
# اختياري: النموذج (الافتراضي gemini-3.8-flash)
GEMINI_MODEL=
# الأسرع والمجاني: مفتاح Groq من https://console.groq.com/keys (بلا بطاقة). إن وُجد صار المزوّد الأول،
# ويبقى Gemini احتياطيًا (وهو الوحيد الذي يقرأ الفيديو).
GROQ_API_KEY=
# اختياري: النموذج (الافتراضي llama-3.3-70b-versatile)
GROQ_MODEL=
# احتياطي أخير: مفتاح OpenRouter من https://openrouter.ai/keys (نماذج مجانية بحدود يومية، أبطأ عادة).
OPENROUTER_API_KEY=
# اختياري: النموذج (الافتراضي openrouter/free: موجّه يختار نموذجًا مجانيًا متاحًا لكل طلب؛ أو سمِّ نموذجًا :free بعينه)
OPENROUTER_MODEL=
# بديل مدفوع: Claude
ANTHROPIC_API_KEY=
# اختياري: النموذج (الافتراضي claude-opus-5-5)
ANTHROPIC_MODEL=
# اختياري: فرض المزوّد (groq | gemini | anthropic)؛ الافتراضي سلسلة Groq ثم Gemini حسب المفاتيح المتوفرة
LLM_PROVIDER=
# استيراد قوائم يوتيوب من لوحة التحكم (قراءة العناوين والمدد فقط). مفتاح مجاني: Google Cloud Console >
# APIs & Services > فعّل «YouTube Data API v3» > Credentials > Create API key. بدونه يُعطَّل الاستيراد فقط.
YOUTUBE_API_KEY=
# مفتاح الخدمة لكتابة لوحة التحكم على Supabase (سرّي: على الخادم فقط، لا تضعه في NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# رفع الفيديو من لوحة التحكم إلى Cloudinary (الخطة المجانية تكفي للبداية). اتركها فارغة لإخفاء خيار الرفع.
# Settings > API Keys في لوحة Cloudinary. السر لا يغادر الخادم أبدًا.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
