# نسخة مثال لمتغيرات البيئة. انسخها إلى apps/web/.env.local واملأ القيم.
# بدون مفاتيح Supabase يعمل الدخول التطويري (غير مسموح في الإنتاج).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# عنوان الموقع لروابط الدخول السحرية (اتركه فارغًا محليًا)
NEXT_PUBLIC_SITE_URL=

# لوحة التحكم الإدارية
# بريد المديرين مفصولًا بفواصل. بدونه في التطوير المحلي (بلا Supabase) يُعامل أي مستخدم مسجَّل كمدير؛
# في الإنتاج بدونه لا يدخل أحد اللوحة.
ADMIN_EMAILS=
# مفتاح الخدمة لكتابة لوحة التحكم على Supabase (سرّي: على الخادم فقط، لا تضعه في NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=
